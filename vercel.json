{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/sheets", "destination": "/api/sheets" },
    { "source": "/planeador", "destination": "/planeador.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/retos", "destination": "/retos.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/recordatorios-pago", "schedule": "0 17 * * *" }
  ],
  "functions": {
    "api/recordatorios-pago.js": {
      "maxDuration": 60
    }
  }
}
